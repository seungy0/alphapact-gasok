FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    PORT=4190 \
    HOST=0.0.0.0

COPY --chown=node:node connector/upbit-readonly.mjs connector/upbit-exchange.mjs ./connector/
COPY --chown=node:node agent/live-executor.mjs ./agent/live-executor.mjs
COPY --chown=node:node agent/upbit-spot-pilot.mjs ./agent/upbit-spot-pilot.mjs

USER node
EXPOSE 4190

HEALTHCHECK --interval=30s --timeout=8s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4190/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["node", "agent/live-executor.mjs"]
