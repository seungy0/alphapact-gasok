{
  "name": "alphapact-testnet",
  "main": "worker.ts",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OPERATOR",
        "class_name": "TestnetOperator"
      },
      {
        "name": "SPOT",
        "class_name": "UpbitSpotOperator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "TestnetOperator"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "UpbitSpotOperator"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GIWA_RPC_URL": "https://sepolia-rpc.giwa.io"
  }
}
